---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { formatDate } from '../lib/date';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  type="article"
>
  <article class:list={['post-shell', { 'post-shell--with-cover': Boolean(post.data.cover) }]}>
    <header class="post-header">
      <a class="back-link" href="/blog/">← 返回博客</a>
      <p class="eyebrow">Writing / {formatDate(post.data.pubDate)}</p>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <ul class="tag-list tag-list--center" aria-label="文章标签">
        {post.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {post.data.cover && (
      <figure class="post-cover page-width">
        <img src={post.data.cover.src} alt={post.data.cover.alt} decoding="async" />
        {post.data.cover.caption && <figcaption>{post.data.cover.caption}</figcaption>}
      </figure>
    )}

    {tocHeadings.length > 1 && (
      <nav class="post-toc" aria-label="文章目录">
        <p>本文目录</p>
        <ol>
          {tocHeadings.map((heading) => (
            <li class:list={{ 'post-toc-subheading': heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a class="text-link" href="/blog/">← 返回全部文章</a>
    </footer>
    <ImageLightbox />
  </article>
</BaseLayout>

<script>
  const toc = document.querySelector<HTMLElement>('.post-toc');
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const updateCurrentHeading = () => {
      let currentIndex = 0;
      sections.forEach((section, index) => {
        if (section && section.getBoundingClientRect().top <= window.innerHeight * 0.28) {
          currentIndex = index;
        }
      });
      links.forEach((link, index) => {
        if (index === currentIndex) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', updateCurrentHeading, { passive: true });
    updateCurrentHeading();
  }
</script>
